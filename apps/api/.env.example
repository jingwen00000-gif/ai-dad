NODE_ENV=development
# 本地开发（docker compose 默认值）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/child_growth?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000

# JWT（生产环境务必换成 32 位以上随机串）
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=2592000

# 微信小程序（Sprint 1 使用）
WX_APPID=""
WX_SECRET=""
# 本地开发不连微信：openid = "mock_" + code。生产环境（NODE_ENV=production）会拒绝启动
WX_MOCK_LOGIN=true

# 语音（家人声音克隆 → Voice ID → 文字转语音）
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
VOICE_STORAGE_DIR="./storage"
PUBLIC_BASE_URL="http://localhost:3000"
VOICE_URL_TTL_SECONDS=86400
VOICE_DAILY_CHAR_LIMIT=20000
