{
  "name": "@cgo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint:types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db execute --file ../../infra/sql/seed/001_interests.sql --schema prisma/schema.prisma",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
