# 由 deploy/install.sh 自动生成 deploy/.env；也可以手动复制本文件修改。不要提交到 Git。

# 后端的 HTTPS 地址（不带 https://）。没有域名时用 sslip.io：服务器 IP 1.2.3.4 → ai-dad.1-2-3-4.sslip.io
API_DOMAIN=ai-dad.1-2-3-4.sslip.io
# 允许访问后端的网页地址（逗号分隔）
CORS_ORIGINS=https://jingwen00000-gif.github.io

# 自动生成的随机密码 / 密钥
POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long

# 可选：家人声音（ElevenLabs）
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOICE_DAILY_CHAR_LIMIT=20000

# 可选：微信小程序登录
WX_APPID=
WX_SECRET=
